---
import { getCollection } from 'astro:content';

// Get all docs entries
const allDocs = await getCollection('docs');

// Starlight uses flat IDs like "si-data" for index pages
// Find project index files - these are direct project folder indexes
const projectIndexes = allDocs.filter(doc => {
  const parts = doc.id.split('/');
  // ID format: "si-data" (for si-data/index.md)
  // Exclude the root index
  if (doc.id === '' || doc.id === 'index') return false;
  // If it's a single segment (like "si-data"), it's a project index
  if (parts.length === 1 && doc.id !== 'index') return true;
  return false;
});

// Extract project info and sort by name
const projects = projectIndexes
  .map(doc => ({
    slug: doc.id,
    name: doc.data.title || doc.id,
    description: doc.data.description || '',
  }))
  .sort((a, b) => a.name.localeCompare(b.name, 'ko'));
---

<div class="project-list">
  {projects.length > 0 ? (
    <ul class="project-items">
      {projects.map((project) => (
        <li class="project-item">
          <a href={`/${project.slug}/`} class="project-link">
            <span class="project-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
              </svg>
            </span>
            <span class="project-info">
              <span class="project-name">{project.name}</span>
              {project.description && (
                <span class="project-desc">{project.description}</span>
              )}
            </span>
            <span class="project-arrow">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18l6-6-6-6"></path>
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="no-projects">등록된 프로젝트가 없습니다.</p>
  )}
</div>

<style>
  .project-list {
    margin-top: 1.5rem;
  }

  .project-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .project-item {
    margin: 0;
    padding: 0;
  }

  .project-item::before {
    display: none;
  }

  .project-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .project-link:hover {
    border-color: var(--sl-color-gray-4);
    background: var(--sl-color-gray-6);
  }

  .project-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text);
    flex-shrink: 0;
  }

  .project-link:hover .project-icon {
    background: var(--sl-color-gray-5);
  }

  .project-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .project-name {
    font-weight: 600;
    font-size: 1rem;
    color: var(--sl-color-text);
  }

  .project-desc {
    font-size: 0.875rem;
    color: var(--sl-color-gray-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project-arrow {
    display: flex;
    align-items: center;
    color: var(--sl-color-gray-3);
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .project-link:hover .project-arrow {
    color: var(--sl-color-text);
    transform: translateX(4px);
  }

  .no-projects {
    color: var(--sl-color-gray-3);
    font-style: italic;
    text-align: center;
    padding: 2rem;
  }
</style>
