---
// PrintButton.astro - PDF 프린트 버튼 컴포넌트
---

<div class="print-buttons">
  <button class="print-btn" data-print="current" title="현재 문서만 인쇄">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 6 2 18 2 18 9"></polyline>
      <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
      <rect x="6" y="14" width="12" height="8"></rect>
    </svg>
    <span>이 문서 인쇄</span>
  </button>
  <button class="print-btn" data-print="section" title="현재 섹션의 모든 문서 인쇄">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <line x1="16" y1="13" x2="8" y2="13"></line>
      <line x1="16" y1="17" x2="8" y2="17"></line>
      <polyline points="10 9 9 9 8 9"></polyline>
    </svg>
    <span>섹션 전체 인쇄</span>
  </button>
</div>

<!-- 이 문서 인쇄용 모달 -->
<div class="print-modal-overlay" id="currentPrintModal">
  <div class="print-modal print-modal-small">
    <h3>이 문서 인쇄</h3>
    <p class="print-modal-desc">인쇄 헤더에 표시될 정보를 입력해주세요.</p>
    <form id="currentPrintForm">
      <div class="print-form-group">
        <label for="currentClientName">고객사명</label>
        <input type="text" id="currentClientName" name="clientName" placeholder="예: 서울연구원" />
      </div>
      <div class="print-form-group">
        <label for="currentProjectName">프로젝트명</label>
        <input type="text" id="currentProjectName" name="projectName" placeholder="예: LLM 검색 기능 개선 PoC" />
      </div>
      <div class="print-form-group print-checkbox-group">
        <label class="print-checkbox-label">
          <input type="checkbox" id="currentLandscape" name="landscape" />
          <span class="print-checkbox-custom"></span>
          <span>가로 방향 인쇄 (Landscape)</span>
        </label>
      </div>
      <div class="print-modal-actions">
        <button type="button" class="print-modal-btn cancel" id="cancelCurrentPrint">취소</button>
        <button type="submit" class="print-modal-btn confirm">인쇄하기</button>
      </div>
    </form>
  </div>
</div>

<!-- 섹션 전체 인쇄용 모달 -->
<div class="print-modal-overlay" id="printModal">
  <div class="print-modal">
    <h3>섹션 전체 인쇄</h3>
    <p class="print-modal-desc">인쇄 문서에 표시될 정보를 입력해주세요.</p>
    <form id="printForm">
      <div class="print-form-group">
        <label for="clientName">고객사명 <span class="required">*</span></label>
        <input type="text" id="clientName" name="clientName" placeholder="예: 서울연구원" required />
      </div>
      <div class="print-form-group">
        <label for="projectName">프로젝트명 <span class="required">*</span></label>
        <input type="text" id="projectName" name="projectName" placeholder="예: LLM 검색 기능 개선 PoC" required />
      </div>
      <div class="print-form-group">
        <label for="docVersion">문서 버전 <span class="required">*</span></label>
        <input type="text" id="docVersion" name="docVersion" placeholder="예: 1.0" value="1.0" required />
      </div>
      <div class="print-form-group">
        <label for="docType">문서 종류</label>
        <input type="text" id="docType" name="docType" placeholder="예: 기술 문서, 제안서, 설계서" value="기술 문서" />
      </div>
      <div class="print-form-group">
        <label for="docAuthor">작성자</label>
        <input type="text" id="docAuthor" name="docAuthor" placeholder="예: 홍길동" />
      </div>
      <div class="print-form-group">
        <label for="docDate">문서 날짜</label>
        <input type="text" id="docDate" name="docDate" placeholder="비우면 오늘 날짜 (예: 2026년 1월 1일)" />
      </div>
      
      <!-- 변경 이력 섹션 -->
      <div class="print-form-section">
        <label>변경 이력</label>
        <div id="revisionHistory" class="revision-history">
          <div class="revision-item">
            <input type="text" name="revDate[]" placeholder="날짜 (예: 2026-01-28)" class="revision-date" />
            <input type="text" name="revVersion[]" placeholder="버전" class="revision-version" />
            <input type="text" name="revDesc[]" placeholder="변경 내용" class="revision-desc" />
            <input type="text" name="revAuthor[]" placeholder="작성자" class="revision-author" />
          </div>
        </div>
        <button type="button" class="add-revision-btn" id="addRevisionBtn">+ 이력 추가</button>
      </div>
      
      <div class="print-form-group print-checkbox-group">
        <label class="print-checkbox-label">
          <input type="checkbox" id="sectionLandscape" name="landscape" />
          <span class="print-checkbox-custom"></span>
          <span>가로 방향 인쇄 (Landscape)</span>
        </label>
      </div>
      <div class="print-modal-actions">
        <button type="button" class="print-modal-btn cancel" id="cancelPrint">취소</button>
        <button type="submit" class="print-modal-btn confirm">인쇄하기</button>
      </div>
    </form>
  </div>
</div>

<style>
  .print-buttons {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .print-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--grey7, #393a3e);
    background-color: var(--grey1, #f6f6f6);
    border: 1px solid var(--grey3, #d8d8d8);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .print-btn:hover {
    background-color: var(--grey8, #151617);
    color: #ffffff;
    border-color: var(--grey8, #151617);
  }

  .print-btn:active {
    transform: scale(0.98);
  }

  .print-btn svg {
    flex-shrink: 0;
  }

  /* 다크 모드 */
  :root[data-theme='dark'] .print-btn {
    color: #ababab;
    background-color: #2a2b2c;
    border-color: #393a3e;
  }

  :root[data-theme='dark'] .print-btn:hover {
    background-color: #e8e8e8;
    color: var(--grey8, #151617);
    border-color: #e8e8e8;
  }

  /* 로딩 상태 */
  .print-btn.loading {
    opacity: 0.7;
    pointer-events: none;
  }

  .print-btn.loading::after {
    content: '';
    width: 14px;
    height: 14px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-left: 0.25rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* 모달 스타일 */
  .print-modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    overflow-y: auto;
    padding: 2rem;
  }

  .print-modal-overlay.active {
    display: flex;
  }

  .print-modal {
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
    width: 100%;
    max-width: 560px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .print-modal.print-modal-small {
    max-width: 400px;
  }

  :root[data-theme='dark'] .print-modal {
    background: #1a1b1c;
    color: #e8e8e8;
  }

  .print-modal h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--grey8, #151617);
  }

  :root[data-theme='dark'] .print-modal h3 {
    color: #fff;
  }

  .print-modal-desc {
    margin: 0 0 1.25rem 0;
    font-size: 0.875rem;
    color: var(--grey6, #6d6d6d);
  }

  :root[data-theme='dark'] .print-modal-desc {
    color: #ababab;
  }

  .print-form-group {
    margin-bottom: 1rem;
  }

  .print-form-group label,
  .print-form-section > label {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 0.375rem;
    color: var(--grey7, #393a3e);
  }

  :root[data-theme='dark'] .print-form-group label,
  :root[data-theme='dark'] .print-form-section > label {
    color: #e8e8e8;
  }

  .print-form-group .required {
    color: #dc3545;
  }

  .print-form-group input,
  .revision-item input {
    width: 100%;
    padding: 0.5rem 0.625rem;
    font-size: 0.875rem;
    border: 1px solid var(--grey3, #d8d8d8);
    border-radius: 6px;
    font-family: inherit;
    transition: border-color 0.2s;
  }

  .print-form-group input:focus,
  .revision-item input:focus {
    outline: none;
    border-color: var(--grey8, #151617);
  }

  :root[data-theme='dark'] .print-form-group input,
  :root[data-theme='dark'] .revision-item input {
    background: #2a2b2c;
    border-color: #393a3e;
    color: #e8e8e8;
  }

  :root[data-theme='dark'] .print-form-group input:focus,
  :root[data-theme='dark'] .revision-item input:focus {
    border-color: #e8e8e8;
  }

  /* 변경 이력 섹션 */
  .print-form-section {
    margin-bottom: 1rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--grey3, #d8d8d8);
  }

  :root[data-theme='dark'] .print-form-section {
    border-top-color: #393a3e;
  }

  .revision-history {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .revision-item {
    display: grid;
    grid-template-columns: 1fr 0.6fr 1.5fr 0.8fr;
    gap: 0.375rem;
  }

  .revision-item input {
    font-size: 0.8125rem;
    padding: 0.375rem 0.5rem;
  }

  .add-revision-btn {
    background: none;
    border: 1px dashed var(--grey3, #d8d8d8);
    color: var(--grey6, #6d6d6d);
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }

  .add-revision-btn:hover {
    border-color: var(--grey8, #151617);
    color: var(--grey8, #151617);
  }

  :root[data-theme='dark'] .add-revision-btn {
    border-color: #393a3e;
    color: #ababab;
  }

  :root[data-theme='dark'] .add-revision-btn:hover {
    border-color: #e8e8e8;
    color: #e8e8e8;
  }

  .print-modal-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .print-modal-btn {
    flex: 1;
    padding: 0.625rem 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }

  .print-modal-btn.cancel {
    background: var(--grey1, #f6f6f6);
    border: 1px solid var(--grey3, #d8d8d8);
    color: var(--grey7, #393a3e);
  }

  .print-modal-btn.cancel:hover {
    background: var(--grey3, #d8d8d8);
  }

  .print-modal-btn.confirm {
    background: var(--grey8, #151617);
    border: 1px solid var(--grey8, #151617);
    color: #fff;
  }

  .print-modal-btn.confirm:hover {
    background: #000;
  }

  :root[data-theme='dark'] .print-modal-btn.cancel {
    background: #2a2b2c;
    border-color: #393a3e;
    color: #ababab;
  }

  :root[data-theme='dark'] .print-modal-btn.cancel:hover {
    background: #393a3e;
  }

  :root[data-theme='dark'] .print-modal-btn.confirm {
    background: #e8e8e8;
    border-color: #e8e8e8;
    color: #151617;
  }

  /* 반응형 */
  @media (max-width: 600px) {
    .print-buttons {
      flex-direction: column;
    }
    
    .print-btn {
      justify-content: center;
    }

    .revision-item {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* 체크박스 (가로 인쇄 옵션) */
  .print-checkbox-group {
    margin-top: 0.25rem;
    margin-bottom: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--grey3, #d8d8d8);
  }

  :root[data-theme='dark'] .print-checkbox-group {
    border-top-color: #393a3e;
  }

  .print-checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--grey7, #393a3e);
    user-select: none;
  }

  :root[data-theme='dark'] .print-checkbox-label {
    color: #e8e8e8;
  }

  .print-checkbox-label input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .print-checkbox-custom {
    display: inline-block;
    width: 18px;
    height: 18px;
    border: 1.5px solid var(--grey4, #ababab);
    border-radius: 4px;
    background: #fff;
    transition: all 0.15s ease;
    position: relative;
    flex-shrink: 0;
  }

  .print-checkbox-label input[type="checkbox"]:checked + .print-checkbox-custom {
    background: var(--grey8, #151617);
    border-color: var(--grey8, #151617);
  }

  .print-checkbox-label input[type="checkbox"]:checked + .print-checkbox-custom::after {
    content: '';
    position: absolute;
    left: 4.5px;
    top: 1.5px;
    width: 5px;
    height: 9px;
    border: solid #fff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .print-checkbox-label input[type="checkbox"]:focus-visible + .print-checkbox-custom {
    outline: 2px solid var(--grey8, #151617);
    outline-offset: 2px;
  }

  :root[data-theme='dark'] .print-checkbox-custom {
    background: #2a2b2c;
    border-color: #6d6d6d;
  }

  :root[data-theme='dark'] .print-checkbox-label input[type="checkbox"]:checked + .print-checkbox-custom {
    background: #e8e8e8;
    border-color: #e8e8e8;
  }

  :root[data-theme='dark'] .print-checkbox-label input[type="checkbox"]:checked + .print-checkbox-custom::after {
    border-color: #151617;
  }

  :root[data-theme='dark'] .print-checkbox-label input[type="checkbox"]:focus-visible + .print-checkbox-custom {
    outline-color: #e8e8e8;
  }
</style>

<script>
  // 계층 구조를 가진 링크 타입
  interface TocItem {
    href?: string;
    title: string;
    level: number;
    isGroup: boolean;
    children?: TocItem[];
  }

  // 프린트 버튼 이벤트 핸들러
  document.addEventListener('DOMContentLoaded', () => {
    const printButtons = document.querySelectorAll('.print-btn');
    
    // 섹션 인쇄 모달
    const modal = document.getElementById('printModal');
    const form = document.getElementById('printForm') as HTMLFormElement;
    const cancelBtn = document.getElementById('cancelPrint');
    const addRevisionBtn = document.getElementById('addRevisionBtn');
    const revisionHistory = document.getElementById('revisionHistory');
    
    // 이 문서 인쇄 모달
    const currentModal = document.getElementById('currentPrintModal');
    const currentForm = document.getElementById('currentPrintForm') as HTMLFormElement;
    const cancelCurrentBtn = document.getElementById('cancelCurrentPrint');
    
    printButtons.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const printType = (e.currentTarget as HTMLButtonElement).dataset.print;
        
        if (printType === 'current') {
          // 이 문서 인쇄 모달 표시
          currentModal?.classList.add('active');
        } else if (printType === 'section') {
          // 섹션 전체 인쇄 모달 표시
          modal?.classList.add('active');
        }
      });
    });

    // === 이 문서 인쇄 모달 핸들러 ===
    cancelCurrentBtn?.addEventListener('click', () => {
      currentModal?.classList.remove('active');
    });

    currentModal?.addEventListener('click', (e) => {
      if (e.target === currentModal) {
        currentModal.classList.remove('active');
      }
    });

    currentForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(currentForm);
      const clientName = formData.get('clientName') as string || '';
      const projectName = formData.get('projectName') as string || '';
      const landscape = (document.getElementById('currentLandscape') as HTMLInputElement)?.checked || false;
      
      currentModal?.classList.remove('active');
      printCurrentPage(clientName, projectName, landscape);
    });

    // === 섹션 전체 인쇄 모달 핸들러 ===
    // 변경 이력 추가 버튼
    addRevisionBtn?.addEventListener('click', () => {
      const newItem = document.createElement('div');
      newItem.className = 'revision-item';
      newItem.innerHTML = `
        <input type="text" name="revDate[]" placeholder="날짜" class="revision-date" />
        <input type="text" name="revVersion[]" placeholder="버전" class="revision-version" />
        <input type="text" name="revDesc[]" placeholder="변경 내용" class="revision-desc" />
        <input type="text" name="revAuthor[]" placeholder="작성자" class="revision-author" />
      `;
      revisionHistory?.appendChild(newItem);
    });

    // 모달 취소
    cancelBtn?.addEventListener('click', () => {
      modal?.classList.remove('active');
    });

    // 모달 외부 클릭 시 닫기
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('active');
      }
    });

    // 폼 제출
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const clientName = formData.get('clientName') as string;
      const projectName = formData.get('projectName') as string;
      const docVersion = formData.get('docVersion') as string;
      const docType = formData.get('docType') as string;
      const docAuthor = formData.get('docAuthor') as string;
      const docDate = formData.get('docDate') as string;
      
      // 변경 이력 수집
      const revDates = formData.getAll('revDate[]') as string[];
      const revVersions = formData.getAll('revVersion[]') as string[];
      const revDescs = formData.getAll('revDesc[]') as string[];
      const revAuthors = formData.getAll('revAuthor[]') as string[];
      
      const revisions: { date: string; version: string; desc: string; author: string }[] = [];
      for (let i = 0; i < revDates.length; i++) {
        if (revDates[i] || revVersions[i] || revDescs[i] || revAuthors[i]) {
          revisions.push({
            date: revDates[i] || '-',
            version: revVersions[i] || '-',
            desc: revDescs[i] || '-',
            author: revAuthors[i] || '-'
          });
        }
      }
      
      modal?.classList.remove('active');
      
      const landscape = (document.getElementById('sectionLandscape') as HTMLInputElement)?.checked || false;
      
      const btn = document.querySelector('[data-print="section"]') as HTMLButtonElement;
      await printSection(btn, clientName, projectName, docVersion, docType, docAuthor, docDate, revisions, landscape);
    });
  });

  // 현재 문서만 인쇄
  function printCurrentPage(clientName: string, projectName: string, landscape: boolean) {
    // 인쇄 헤더의 타이틀에 고객사명/프로젝트명 표시
    const titleEl = document.querySelector('.print-header-title');
    if (titleEl) {
      const parts = [];
      if (clientName) parts.push(clientName);
      if (projectName) parts.push(projectName);
      titleEl.textContent = parts.join(' | ');
    }
    
    // 가로 인쇄 스타일 동적 주입
    let landscapeStyle: HTMLStyleElement | null = null;
    if (landscape) {
      landscapeStyle = document.createElement('style');
      landscapeStyle.id = 'print-landscape-style';
      landscapeStyle.textContent = '@media print { @page { size: A4 landscape; margin: 12mm; } }';
      document.head.appendChild(landscapeStyle);
    }
    
    window.print();
    
    // 인쇄 후 landscape 스타일 제거
    if (landscapeStyle) {
      landscapeStyle.remove();
    }
  }

  // 섹션 전체 인쇄
  async function printSection(
    btn: HTMLButtonElement, 
    clientName: string, 
    projectName: string, 
    docVersion: string,
    docType: string,
    docAuthor: string,
    docDate: string,
    revisions: { date: string; version: string; desc: string; author: string }[],
    landscape: boolean
  ) {
    btn.classList.add('loading');
    const originalText = btn.querySelector('span')?.textContent || '';
    const spanEl = btn.querySelector('span');
    if (spanEl) spanEl.textContent = '준비 중...';

    try {
      // 현재 섹션의 링크들 가져오기 (계층 구조)
      const tocItems = getSectionLinks();
      const flatLinks = flattenTocItems(tocItems);
      
      if (flatLinks.length === 0) {
        alert('섹션 문서를 찾을 수 없습니다.');
        return;
      }

      if (spanEl) spanEl.textContent = `${flatLinks.length}개 문서 수집 중...`;

      // 모든 페이지 콘텐츠 가져오기 (진행 상황 표시)
      const contents = await fetchAllPages(flatLinks, (current, total) => {
        if (spanEl) spanEl.textContent = `${current}/${total} 처리 중...`;
      });
      
      // 큰 이미지/표 경고 집계
      const totalLargeImages = contents.reduce((sum, c) => sum + c.warnings.largeImages, 0);
      const totalLargeTables = contents.reduce((sum, c) => sum + c.warnings.largeTables, 0);
      
      if ((totalLargeImages > 0 || totalLargeTables > 0) && !landscape) {
        const warningParts = [];
        if (totalLargeImages > 0) warningParts.push(`큰 이미지 ${totalLargeImages}개`);
        if (totalLargeTables > 0) warningParts.push(`긴 표 ${totalLargeTables}개`);
        const proceed = confirm(
          `${warningParts.join(', ')}가 포함되어 있습니다.\n` +
          `세로 인쇄 시 가독성이 떨어질 수 있습니다.\n\n` +
          `가로(Landscape) 인쇄를 권장합니다.\n` +
          `[확인] 그대로 진행 / [취소] 취소 후 가로 인쇄 옵션 선택`
        );
        if (!proceed) {
          btn.classList.remove('loading');
          if (spanEl) spanEl.textContent = originalText;
          return;
        }
      }
      
      // 섹션 타이틀 가져오기
      const sectionTitle = getSectionTitle();
      
      // 새 창에서 인쇄 (계층 구조 정보 함께 전달)
      printCombinedContent(contents, clientName, projectName, docVersion, docType, docAuthor, docDate, revisions, tocItems, landscape);
      
    } catch (error) {
      console.error('섹션 인쇄 오류:', error);
      alert('섹션 인쇄 중 오류가 발생했습니다.');
    } finally {
      btn.classList.remove('loading');
      const spanEl = btn.querySelector('span');
      if (spanEl) spanEl.textContent = originalText;
    }
  }

  // 현재 섹션의 제목 가져오기
  function getSectionTitle(): string {
    const sidebar = document.querySelector('nav.sidebar');
    if (!sidebar) return '';

    const currentLink = sidebar.querySelector(`a[aria-current="page"]`);
    if (!currentLink) return '';

    const parentDetails = currentLink.closest('details');
    if (!parentDetails) return '';

    const summary = parentDetails.querySelector(':scope > summary');
    if (!summary) return '';

    // summary 내부의 텍스트 추출 (group-label 클래스 또는 직접 텍스트)
    const groupLabel = summary.querySelector('.group-label');
    return groupLabel?.textContent?.trim() || summary.textContent?.trim() || '';
  }

  // 사이드바에서 현재 섹션의 링크들 추출 (계층 구조 포함)
  function getSectionLinks(): TocItem[] {
    const items: TocItem[] = [];
    
    // 사이드바에서 현재 활성화된 링크의 부모 섹션 찾기
    const sidebar = document.querySelector('nav.sidebar');
    if (!sidebar) return items;

    // 현재 페이지가 속한 details 찾기
    const currentLink = sidebar.querySelector(`a[aria-current="page"]`);
    if (!currentLink) return items;

    // 현재 페이지가 속한 최상위 details 찾기
    const parentDetails = currentLink.closest('details');
    if (!parentDetails) return items;

    // 재귀적으로 계층 구조 추출
    function extractItems(container: Element, level: number): TocItem[] {
      const result: TocItem[] = [];
      
      // 직접 자식 li 요소들만 처리
      const directUl = container.querySelector(':scope > ul');
      if (!directUl) return result;
      
      const directLis = directUl.querySelectorAll(':scope > li');
      
      directLis.forEach(li => {
        const nestedDetails = li.querySelector(':scope > details');
        
        if (nestedDetails) {
          // 그룹 (하위 섹션이 있는 경우)
          const summary = nestedDetails.querySelector(':scope > summary');
          const groupTitle = summary?.querySelector('.group-label')?.textContent?.trim() || 
                            summary?.textContent?.trim() || '그룹';
          
          const groupItem: TocItem = {
            title: groupTitle,
            level: level,
            isGroup: true,
            children: extractItems(nestedDetails, level + 1)
          };
          result.push(groupItem);
        } else {
          // 일반 링크
          const link = li.querySelector(':scope > a[href]');
          if (link) {
            const href = link.getAttribute('href');
            const title = link.textContent?.trim() || '';
            if (href && title && !href.startsWith('#')) {
              result.push({
                href,
                title,
                level: level,
                isGroup: false
              });
            }
          }
        }
      });
      
      return result;
    }

    return extractItems(parentDetails, 0);
  }

  // 계층 구조를 평탄화하여 링크 목록으로 변환
  function flattenTocItems(items: TocItem[]): { href: string; title: string }[] {
    const result: { href: string; title: string }[] = [];
    
    function flatten(items: TocItem[]) {
      for (const item of items) {
        if (!item.isGroup && item.href) {
          result.push({ href: item.href, title: item.title });
        }
        if (item.children) {
          flatten(item.children);
        }
      }
    }
    
    flatten(items);
    return result;
  }

  // 모든 페이지 콘텐츠 가져오기
  async function fetchAllPages(
    links: { href: string; title: string }[],
    progressCallback?: (current: number, total: number) => void
  ): Promise<{ title: string; content: string; warnings: { largeImages: number; largeTables: number } }[]> {
    const contents: { title: string; content: string; warnings: { largeImages: number; largeTables: number } }[] = [];
    const failed: { href: string; title: string; reason: string }[] = [];
    
    for (let i = 0; i < links.length; i++) {
      const link = links[i];
      progressCallback?.(i + 1, links.length);
      try {
        const response = await fetch(link.href);
        if (!response.ok) {
          failed.push({ href: link.href, title: link.title, reason: `HTTP ${response.status}` });
          console.error(`페이지 로드 실패: ${link.href} - HTTP ${response.status}`);
          continue;
        }
        const html = await response.text();
        
        // HTML 파싱
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        
        // 메인 콘텐츠 추출
        const mainContent = doc.querySelector('.sl-markdown-content');
        if (!mainContent) {
          failed.push({ href: link.href, title: link.title, reason: '.sl-markdown-content 요소 없음' });
          console.error(`콘텐츠 영역을 찾을 수 없음: ${link.href}`);
          continue;
        }
        
        {
          // 이미지 경로를 절대 경로로 변환 + 큰 이미지 감지
          const baseUrl = new URL(link.href, window.location.origin);
          const images = mainContent.querySelectorAll('img');
          let largeImageCount = 0;
          images.forEach(img => {
            const src = img.getAttribute('src');
            if (src && !src.startsWith('http') && !src.startsWith('data:')) {
              const absoluteUrl = new URL(src, baseUrl).href;
              img.setAttribute('src', absoluteUrl);
            }
            // 이미지의 자연 크기 추정 (width/height 속성 또는 src 파일명 기반)
            const width = parseInt(img.getAttribute('width') || '0');
            const height = parseInt(img.getAttribute('height') || '0');
            // A4 세로 인쇄 영역(약 180mm × 240mm = 680px × 907px @ 96dpi) 초과 시 큰 이미지로 판정
            if (width > 800 || height > 1000) {
              largeImageCount++;
            }
          });

          // 큰 표 감지 (20행 이상) + thead 자동 복제 보완
          const tables = mainContent.querySelectorAll('table');
          let largeTableCount = 0;
          tables.forEach(table => {
            const rowCount = table.querySelectorAll('tbody tr').length;
            if (rowCount >= 20) {
              largeTableCount++;
              // thead가 있으면 display: table-header-group을 강제 보장
              const thead = table.querySelector('thead');
              if (thead) {
                (thead as HTMLElement).style.display = 'table-header-group';
              }
            }
          });

          // 마크다운 본문의 첫 번째 h1 제거 (printCombinedContent에서 item.title로 별도 출력하므로 중복 방지)
          const firstH1Wrapper = mainContent.querySelector('.sl-heading-wrapper:has(> h1)');
          if (firstH1Wrapper) {
            firstH1Wrapper.remove();
          } else {
            // sl-heading-wrapper가 없는 경우 직접 h1 제거
            const firstH1 = mainContent.querySelector('h1');
            if (firstH1) firstH1.remove();
          }

          // [제목 + 이미지] 패턴을 .heading-image-block으로 묶어 페이지 분리 방지
          // 패턴: .sl-heading-wrapper(h2/h3) + p(img) 또는 .sl-heading-wrapper + p + p(img)
          const headingWrappers = mainContent.querySelectorAll('.sl-heading-wrapper');
          headingWrappers.forEach(wrapper => {
            const heading = wrapper.querySelector('h2, h3, h4');
            if (!heading) return;
            
            // 직후 1~2개의 형제 요소 중 이미지가 있는지 확인
            const sibling1 = wrapper.nextElementSibling;
            if (!sibling1) return;
            const sibling2 = sibling1.nextElementSibling;
            
            let imageElement: Element | null = null;
            const elementsToWrap: Element[] = [];
            
            // case 1: 바로 다음 형제에 img가 있음
            if (sibling1.querySelector?.('img')) {
              imageElement = sibling1;
              elementsToWrap.push(sibling1);
            }
            // case 2: 다음 형제는 짧은 설명(p), 그 다음에 img
            else if (sibling1.tagName === 'P' && sibling1.textContent && sibling1.textContent.trim().length < 200 && sibling2?.querySelector?.('img')) {
              imageElement = sibling2;
              elementsToWrap.push(sibling1, sibling2);
            }
            
            if (imageElement && elementsToWrap.length > 0) {
              // 묶음 div 생성
              const block = doc.createElement('div');
              block.className = 'heading-image-block';
              wrapper.parentNode?.insertBefore(block, wrapper);
              block.appendChild(wrapper);
              elementsToWrap.forEach(el => block.appendChild(el));
            }
          });

          // 작성 이력 섹션 제거 (h2/h3 #작성-이력 및 후속 요소)
          const historyHeading = mainContent.querySelector('#작성-이력');
          if (historyHeading) {
            const wrapper = historyHeading.closest('.sl-heading-wrapper') || historyHeading;
            let sibling = wrapper.nextElementSibling;
            while (sibling) {
              const next = sibling.nextElementSibling;
              sibling.remove();
              sibling = next;
            }
            wrapper.remove();
          }
          
          // 페이지 네비게이션 링크 제거 (← Part X | Part Y → 패턴)
          let contentHtml = mainContent.innerHTML;
          contentHtml = contentHtml.replace(/<p>\s*<a[^>]*>←[^<]*<\/a>\s*\|\s*<a[^>]*>[^<]*→<\/a>\s*<\/p>/gi, '');
          contentHtml = contentHtml.replace(/<p>\s*<a[^>]*>←[^<]*<\/a>\s*<\/p>/gi, '');
          contentHtml = contentHtml.replace(/<p>\s*<a[^>]*>[^<]*→<\/a>\s*<\/p>/gi, '');
          
          contents.push({
            title: link.title,
            content: contentHtml,
            warnings: { largeImages: largeImageCount, largeTables: largeTableCount }
          });
        }
      } catch (error) {
        failed.push({ href: link.href, title: link.title, reason: String(error) });
        console.error(`페이지 로드 실패: ${link.href}`, error);
      }
    }
    
    // 누락된 문서가 있으면 사용자에게 알림 (인쇄는 계속 진행)
    if (failed.length > 0) {
      const failedList = failed.map(f => `  • ${f.title} (${f.reason})`).join('\n');
      alert(
        `${failed.length}개 문서를 불러오지 못해 인쇄에서 제외됩니다:\n\n${failedList}\n\n` +
        `(전체 ${links.length}개 중 ${contents.length}개만 인쇄됩니다)\n` +
        `자세한 내용은 브라우저 콘솔(F12)을 확인해주세요.`
      );
    }
    
    return contents;
  }

  // 조합된 콘텐츠를 새 창에서 인쇄
  function printCombinedContent(
    contents: { title: string; content: string; warnings?: { largeImages: number; largeTables: number } }[], 
    clientName: string, 
    projectName: string,
    docVersion: string,
    docType: string,
    docAuthor: string,
    docDate: string,
    revisions: { date: string; version: string; desc: string; author: string }[],
    tocItems: TocItem[],
    landscape: boolean
  ) {
    // 로고 이미지 URL 가져오기
    const logoImg = document.querySelector('.skunkworks-logo img') as HTMLImageElement;
    const logoSrc = logoImg?.src || '/skunkworks-logo.png';
    
    // 프로젝트명 줄바꿈 처리 (\n → <br>)
    const projectNameHtml = projectName.replace(/\\n/g, '<br>');
    
    // 문서 날짜 (입력값 또는 오늘 날짜)
    const displayDate = docDate || new Date().toLocaleDateString('ko-KR', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });

    // 계층적 목차 HTML 생성
    let docIndex = 0;
    function generateTocHtml(items: TocItem[], level: number = 0): string {
      let html = '';
      
      for (const item of items) {
        if (item.isGroup) {
          // 그룹 제목
          html += `<div class="toc-group" style="margin-left: ${level * 1.5}rem; margin-top: ${level === 0 ? '1.5rem' : '0.75rem'};">
            <span class="toc-group-title">${item.title}</span>
          </div>`;
          
          // 하위 항목들
          if (item.children && item.children.length > 0) {
            html += generateTocHtml(item.children, level + 1);
          }
        } else if (item.href) {
          // 일반 문서 링크
          docIndex++;
          html += `<div class="toc-item" style="margin-left: ${level * 1.5}rem;">
            <span class="toc-number">${docIndex}</span>
            <span class="toc-title">${item.title}</span>
          </div>`;
        }
      }
      
      return html;
    }
    
    const tocHtml = generateTocHtml(tocItems);

    // 변경 이력 HTML 생성
    const revisionHtml = revisions.length > 0 ? `
      <div class="revision-section">
        <h3>변경 이력</h3>
        <table class="revision-table">
          <thead>
            <tr>
              <th>날짜</th>
              <th>버전</th>
              <th>변경 내용</th>
              <th>작성자</th>
