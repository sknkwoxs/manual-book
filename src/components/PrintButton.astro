---
// PrintButton.astro - PDF 프린트 버튼 컴포넌트
---

<div class="print-buttons">
  <button class="print-btn" data-print="current" title="현재 문서만 인쇄">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 6 2 18 2 18 9"></polyline>
      <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
      <rect x="6" y="14" width="12" height="8"></rect>
    </svg>
    <span>이 문서 인쇄</span>
  </button>
  <button class="print-btn" data-print="section" title="현재 섹션의 모든 문서 인쇄">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <line x1="16" y1="13" x2="8" y2="13"></line>
      <line x1="16" y1="17" x2="8" y2="17"></line>
      <polyline points="10 9 9 9 8 9"></polyline>
    </svg>
    <span>섹션 전체 인쇄</span>
  </button>
</div>

<!-- 섹션 전체 인쇄용 모달 -->
<div class="print-modal-overlay" id="printModal">
  <div class="print-modal">
    <h3>섹션 전체 인쇄</h3>
    <p class="print-modal-desc">인쇄 문서에 표시될 정보를 입력해주세요.</p>
    <form id="printForm">
      <div class="print-form-group">
        <label for="clientName">고객사명 <span class="required">*</span></label>
        <input type="text" id="clientName" name="clientName" placeholder="예: 서울연구원" required />
      </div>
      <div class="print-form-group">
        <label for="projectName">프로젝트명 <span class="required">*</span></label>
        <input type="text" id="projectName" name="projectName" placeholder="예: LLM 검색 기능 개선 PoC" required />
      </div>
      <div class="print-modal-actions">
        <button type="button" class="print-modal-btn cancel" id="cancelPrint">취소</button>
        <button type="submit" class="print-modal-btn confirm">인쇄하기</button>
      </div>
    </form>
  </div>
</div>

<style>
  .print-buttons {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .print-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--grey7, #393a3e);
    background-color: var(--grey1, #f6f6f6);
    border: 1px solid var(--grey3, #d8d8d8);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .print-btn:hover {
    background-color: var(--grey8, #151617);
    color: #ffffff;
    border-color: var(--grey8, #151617);
  }

  .print-btn:active {
    transform: scale(0.98);
  }

  .print-btn svg {
    flex-shrink: 0;
  }

  /* 다크 모드 */
  :root[data-theme='dark'] .print-btn {
    color: #ababab;
    background-color: #2a2b2c;
    border-color: #393a3e;
  }

  :root[data-theme='dark'] .print-btn:hover {
    background-color: #e8e8e8;
    color: var(--grey8, #151617);
    border-color: #e8e8e8;
  }

  /* 로딩 상태 */
  .print-btn.loading {
    opacity: 0.7;
    pointer-events: none;
  }

  .print-btn.loading::after {
    content: '';
    width: 14px;
    height: 14px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-left: 0.25rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* 모달 스타일 */
  .print-modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .print-modal-overlay.active {
    display: flex;
  }

  .print-modal {
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
    width: 90%;
    max-width: 400px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  :root[data-theme='dark'] .print-modal {
    background: #1a1b1c;
    color: #e8e8e8;
  }

  .print-modal h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--grey8, #151617);
  }

  :root[data-theme='dark'] .print-modal h3 {
    color: #fff;
  }

  .print-modal-desc {
    margin: 0 0 1.25rem 0;
    font-size: 0.875rem;
    color: var(--grey6, #6d6d6d);
  }

  :root[data-theme='dark'] .print-modal-desc {
    color: #ababab;
  }

  .print-form-group {
    margin-bottom: 1rem;
  }

  .print-form-group label {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 0.375rem;
    color: var(--grey7, #393a3e);
  }

  :root[data-theme='dark'] .print-form-group label {
    color: #e8e8e8;
  }

  .print-form-group .required {
    color: #dc3545;
  }

  .print-form-group input {
    width: 100%;
    padding: 0.625rem 0.75rem;
    font-size: 0.9375rem;
    border: 1px solid var(--grey3, #d8d8d8);
    border-radius: 6px;
    font-family: inherit;
    transition: border-color 0.2s;
  }

  .print-form-group input:focus {
    outline: none;
    border-color: var(--grey8, #151617);
  }

  :root[data-theme='dark'] .print-form-group input {
    background: #2a2b2c;
    border-color: #393a3e;
    color: #e8e8e8;
  }

  :root[data-theme='dark'] .print-form-group input:focus {
    border-color: #e8e8e8;
  }

  .print-modal-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .print-modal-btn {
    flex: 1;
    padding: 0.625rem 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }

  .print-modal-btn.cancel {
    background: var(--grey1, #f6f6f6);
    border: 1px solid var(--grey3, #d8d8d8);
    color: var(--grey7, #393a3e);
  }

  .print-modal-btn.cancel:hover {
    background: var(--grey3, #d8d8d8);
  }

  .print-modal-btn.confirm {
    background: var(--grey8, #151617);
    border: 1px solid var(--grey8, #151617);
    color: #fff;
  }

  .print-modal-btn.confirm:hover {
    background: #000;
  }

  :root[data-theme='dark'] .print-modal-btn.cancel {
    background: #2a2b2c;
    border-color: #393a3e;
    color: #ababab;
  }

  :root[data-theme='dark'] .print-modal-btn.cancel:hover {
    background: #393a3e;
  }

  :root[data-theme='dark'] .print-modal-btn.confirm {
    background: #e8e8e8;
    border-color: #e8e8e8;
    color: #151617;
  }

  /* 반응형 */
  @media (max-width: 480px) {
    .print-buttons {
      flex-direction: column;
    }
    
    .print-btn {
      justify-content: center;
    }
  }
</style>

<script>
  // 프린트 버튼 이벤트 핸들러
  document.addEventListener('DOMContentLoaded', () => {
    const printButtons = document.querySelectorAll('.print-btn');
    const modal = document.getElementById('printModal');
    const form = document.getElementById('printForm') as HTMLFormElement;
    const cancelBtn = document.getElementById('cancelPrint');
    
    printButtons.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const printType = (e.currentTarget as HTMLButtonElement).dataset.print;
        
        if (printType === 'current') {
          printCurrentPage();
        } else if (printType === 'section') {
          // 모달 표시
          modal?.classList.add('active');
        }
      });
    });

    // 모달 취소
    cancelBtn?.addEventListener('click', () => {
      modal?.classList.remove('active');
    });

    // 모달 외부 클릭 시 닫기
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('active');
      }
    });

    // 폼 제출
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const clientName = formData.get('clientName') as string;
      const projectName = formData.get('projectName') as string;
      
      modal?.classList.remove('active');
      
      const btn = document.querySelector('[data-print="section"]') as HTMLButtonElement;
      await printSection(btn, clientName, projectName);
    });
  });

  // 현재 문서만 인쇄
  function printCurrentPage() {
    window.print();
  }

  // 섹션 전체 인쇄
  async function printSection(btn: HTMLButtonElement, clientName: string, projectName: string) {
    btn.classList.add('loading');
    const originalText = btn.querySelector('span')?.textContent || '';
    const spanEl = btn.querySelector('span');
    if (spanEl) spanEl.textContent = '준비 중...';

    try {
      // 현재 섹션의 링크들 가져오기
      const sectionLinks = getSectionLinks();
      
      if (sectionLinks.length === 0) {
        alert('섹션 문서를 찾을 수 없습니다.');
        return;
      }

      if (spanEl) spanEl.textContent = `${sectionLinks.length}개 문서 수집 중...`;

      // 모든 페이지 콘텐츠 가져오기
      const contents = await fetchAllPages(sectionLinks);
      
      // 새 창에서 인쇄
      printCombinedContent(contents, clientName, projectName);
      
    } catch (error) {
      console.error('섹션 인쇄 오류:', error);
      alert('섹션 인쇄 중 오류가 발생했습니다.');
    } finally {
      btn.classList.remove('loading');
      const spanEl = btn.querySelector('span');
      if (spanEl) spanEl.textContent = originalText;
    }
  }

  // 사이드바에서 현재 섹션의 링크들 추출
  function getSectionLinks(): { href: string; title: string }[] {
    const links: { href: string; title: string }[] = [];
    const currentPath = window.location.pathname;
    
    // 사이드바에서 현재 활성화된 링크의 부모 섹션 찾기
    const sidebar = document.querySelector('nav.sidebar');
    if (!sidebar) return links;

    // 현재 페이지가 속한 details/ul 찾기
    const currentLink = sidebar.querySelector(`a[aria-current="page"]`);
    if (!currentLink) return links;

    // 가장 가까운 부모 ul 또는 details 내의 모든 링크 수집
    let parentSection = currentLink.closest('ul');
    if (!parentSection) return links;

    // 상위 details가 있으면 그 안의 모든 링크 가져오기
    const parentDetails = currentLink.closest('details');
    if (parentDetails) {
      parentSection = parentDetails.querySelector('ul');
    }

    if (parentSection) {
      const allLinks = parentSection.querySelectorAll('a[href]');
      allLinks.forEach(link => {
        const href = link.getAttribute('href');
        const title = link.textContent?.trim() || '';
        if (href && title && !href.startsWith('#')) {
          links.push({ href, title });
        }
      });
    }

    return links;
  }

  // 모든 페이지 콘텐츠 가져오기
  async function fetchAllPages(links: { href: string; title: string }[]): Promise<{ title: string; content: string }[]> {
    const contents: { title: string; content: string }[] = [];
    
    for (const link of links) {
      try {
        const response = await fetch(link.href);
        const html = await response.text();
        
        // HTML 파싱
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        
        // 메인 콘텐츠 추출
        const mainContent = doc.querySelector('.sl-markdown-content');
        if (mainContent) {
          contents.push({
            title: link.title,
            content: mainContent.innerHTML
          });
        }
      } catch (error) {
        console.error(`페이지 로드 실패: ${link.href}`, error);
      }
    }
    
    return contents;
  }

  // 조합된 콘텐츠를 새 창에서 인쇄
  function printCombinedContent(contents: { title: string; content: string }[], clientName: string, projectName: string) {
    // 로고 이미지 URL 가져오기
    const logoImg = document.querySelector('.skunkworks-logo img') as HTMLImageElement;
    const logoSrc = logoImg?.src || '/skunkworks-logo.png';
    
    // 현재 날짜
    const today = new Date().toLocaleDateString('ko-KR', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });

    // 인쇄 전용 스타일 (인라인으로 포함)
    const printStyles = `
      @import url('https://cdnjs.cloudflare.com/ajax/libs/pretendard-gov/1.3.9/variable/pretendardvariable-gov-dynamic-subset.min.css');
      
      * {
        box-sizing: border-box;
      }
      
      body {
        font-family: 'Pretendard Variable', 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        font-size: 10pt;
        line-height: 1.5;
        letter-spacing: -0.02em;
        color: #000;
        padding: 0;
        margin: 0;
      }
      
      /* 표지 페이지 */
      .cover-page {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 3rem;
        text-align: center;
        page-break-after: always;
      }
      
      .cover-logo {
        margin-bottom: 3rem;
      }
      
      .cover-logo img {
        height: 32px;
        width: auto;
      }
      
      .cover-title {
        font-size: 28pt;
        font-weight: 700;
        margin: 0 0 1rem 0;
        color: #151617;
      }
      
      .cover-subtitle {
        font-size: 14pt;
        color: #6d6d6d;
        margin: 0 0 3rem 0;
      }
      
      .cover-info {
        margin-top: 2rem;
        font-size: 12pt;
        color: #393a3e;
      }
      
      .cover-info-item {
        margin: 0.5rem 0;
      }
      
      .cover-info-label {
        color: #6d6d6d;
        margin-right: 0.5rem;
      }
      
      .cover-date {
        margin-top: 3rem;
        font-size: 11pt;
        color: #ababab;
      }
      
      /* 콘텐츠 영역 */
      .print-content {
        padding: 20mm 15mm;
      }
      
      /* 페이지 헤더 (각 섹션) */
      .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 0.75rem;
        margin-bottom: 1.5rem;
        border-bottom: 2px solid #151617;
      }
      
      .page-header-title {
        font-size: 11pt;
        font-weight: 600;
        color: #151617;
      }
      
      .page-header-logo img {
        height: 18px;
        width: auto;
      }
      
      .print-section-item {
        page-break-after: always;
      }
      
      .print-section-item:last-child {
        page-break-after: avoid;
      }
      
      /* 제목 스타일 */
      h1 {
        font-size: 18pt;
        font-weight: 700;
        margin: 0 0 0.75rem 0;
        color: #000;
        page-break-after: avoid;
      }
      
      h2 {
        font-size: 14pt;
        font-weight: 600;
        margin: 1.5rem 0 0.5rem 0;
        padding-bottom: 0.25rem;
        border-bottom: 1px solid #ccc;
        color: #000;
        page-break-after: avoid;
      }
      
      h3 {
        font-size: 12pt;
        font-weight: 600;
        margin: 1rem 0 0.5rem 0;
        color: #000;
        page-break-after: avoid;
      }
      
      h4 {
        font-size: 11pt;
        font-weight: 600;
        margin: 0.75rem 0 0.375rem 0;
        color: #000;
        page-break-after: avoid;
      }
      
      /* 본문 */
      p {
        margin: 0.5rem 0;
        orphans: 3;
        widows: 3;
      }
      
      /* 링크 */
      a {
        color: #000;
        text-decoration: underline;
      }
      
      /* 테이블 */
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 9pt;
        margin: 0.75rem 0;
        page-break-inside: avoid;
      }
      
      thead {
        background: #f0f0f0;
      }
      
      th {
        text-align: left;
        padding: 0.4rem 0.5rem;
        font-weight: 600;
        border: 1px solid #ccc;
        color: #000;
      }
      
      td {
        padding: 0.4rem 0.5rem;
        border: 1px solid #ccc;
        vertical-align: top;
      }
      
      tbody tr:nth-child(even) {
        background: #fafafa;
      }
      
      /* 코드 블록 */
      pre {
        font-family: 'SF Mono', Monaco, 'Courier New', monospace;
        font-size: 8pt;
        line-height: 1.4;
        background: #f8f8f8;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 0.5rem 0.75rem;
        margin: 0.5rem 0;
        overflow-x: visible;
        white-space: pre-wrap;
        word-wrap: break-word;
        page-break-inside: avoid;
      }
      
      code {
        font-family: 'SF Mono', Monaco, 'Courier New', monospace;
        font-size: 9pt;
        background: #f0f0f0;
        padding: 0.1em 0.3em;
        border-radius: 3px;
      }
      
      pre code {
        background: transparent;
        padding: 0;
        font-size: 8pt;
      }
      
      /* 리스트 */
      ul, ol {
        margin: 0.5rem 0;
        padding-left: 1.5rem;
      }
      
      li {
        margin: 0.25rem 0;
        line-height: 1.5;
        page-break-inside: avoid;
      }
      
      /* 블록쿼트 */
      blockquote {
        margin: 0.5rem 0;
        padding: 0.5rem 0.75rem;
        background: #f8f8f8;
        border-left: 3px solid #333;
        color: #333;
        page-break-inside: avoid;
      }
      
      /* 이미지 */
      img {
        max-width: 100%;
        height: auto;
        page-break-inside: avoid;
      }
      
      /* 수평선 */
      hr {
        border: none;
        border-top: 1px solid #ccc;
        margin: 1rem 0;
      }
      
      /* 강조 */
      strong {
        font-weight: 600;
        color: #000;
      }
      
      /* Starlight 특수 요소 숨김 */
      .sl-heading-wrapper .sl-anchor-link,
      .expressive-code .header {
        display: none !important;
      }
      
      /* 제목 래퍼 인라인 처리 */
      .sl-heading-wrapper {
        display: block;
      }
      
      @media print {
        @page {
          size: A4;
          margin: 15mm 15mm 20mm 15mm;
        }
        
        .cover-page {
          margin: 0;
          padding: 0;
        }
        
        .print-content {
          padding: 0;
        }
      }
    `;

    // HTML 구성
    const combinedHtml = `<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${projectName} - ${clientName}</title>
  <style>${printStyles}</style>
</head>
<body>
  <!-- 표지 페이지 -->
  <div class="cover-page">
    <div class="cover-logo">
      <img src="${logoSrc}" alt="SKUNKWORKS" />
    </div>
    <h1 class="cover-title">${projectName}</h1>
    <p class="cover-subtitle">기술 문서</p>
    <div class="cover-info">
      <div class="cover-info-item">
        <span class="cover-info-label">고객사</span>
        <strong>${clientName}</strong>
      </div>
    </div>
    <p class="cover-date">${today}</p>
  </div>

  <!-- 콘텐츠 -->
  <div class="print-content">
    ${contents.map((item, index) => `
      <div class="print-section-item">
        <div class="page-header">
          <span class="page-header-title">${projectName}</span>
          <span class="page-header-logo"><img src="${logoSrc}" alt="SKUNKWORKS" /></span>
        </div>
        <h1>${item.title}</h1>
        ${item.content}
      </div>
    `).join('')}
  </div>
</body>
</html>`;

    // 새 창 열고 인쇄
    const printWindow = window.open('', '_blank');
    if (printWindow) {
      printWindow.document.write(combinedHtml);
      printWindow.document.close();
      
      // 폰트 및 이미지 로드 대기 후 인쇄
      setTimeout(() => {
        printWindow.print();
      }, 1000);
    }
  }
</script>
