      }
      
      /* h2: 24px / 600 / #151617 / border-bottom 2px solid #d8d8d8 / margin 40px 0 16px / padding-bottom 8px */
      h2 {
        font-size: 17pt;
        font-weight: 600;
        line-height: 1.4;
        margin: 24pt 0 12pt 0;
        padding: 0 0 6pt 0;
        border-bottom: 1.5pt solid #d8d8d8;
        color: #151617;
        page-break-after: avoid;
        break-after: avoid;
        letter-spacing: -0.02em;
      }
      
      /* h3: 20px / 600 / #393a3e / margin 32px 0 12px */
      h3 {
        font-size: 14pt;
        font-weight: 600;
        line-height: 1.4;
        margin: 18pt 0 8pt 0;
        color: #393a3e;
        page-break-after: avoid;
        break-after: avoid;
      }
      
      h4 {
        font-size: 12pt;
        font-weight: 600;
        line-height: 1.4;
        margin: 12pt 0 6pt 0;
        color: #393a3e;
        page-break-after: avoid;
        break-after: avoid;
      }
      
      /* 제목 + 첫 형제 요소 묶기 */
      h1 + *, h2 + *, h3 + *, h4 + * {
        page-break-before: avoid;
        break-before: avoid;
      }
      
      /* 본문 - p: 16px / 400 / #151617 / line-height 24px (1.5) / margin-top 16px */
      p {
        margin: 11pt 0 0 0;
        font-size: 11pt;
        line-height: 1.5;
        color: #151617;
        orphans: 3;
        widows: 3;
      }
      
      /* 링크 */
      a {
        color: #151617;
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      
      /* 테이블 - 웹 정확 차용: border 1px #d8d8d8 / radius 8px / margin 24px 0 */
      table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 10pt;
        line-height: 1.5;
        margin: 16pt 0;
        border: 0.75pt solid #d8d8d8;
        border-radius: 6pt;
        overflow: hidden;
        color: #151617;
      }
      
      /* thead: 배경 #151617 / 흰 글씨 / padding 14px 16px / font-weight 600 */
      thead {
        display: table-header-group;
        background: #151617;
      }
      
      thead tr {
        background: #151617;
      }
      
      tbody {
        display: table-row-group;
      }
      
      tr {
        page-break-inside: avoid;
        break-inside: avoid;
      }
      
      th {
        text-align: left;
        padding: 10pt 12pt;
        font-weight: 600;
        font-size: 10pt;
        color: #ffffff;
        background: #151617;
        border: none;
        line-height: 1.5;
      }
      
      /* td: padding 12px 16px / border-bottom 1px #d8d8d8 / font 14.4px */
      td {
        padding: 9pt 12pt;
        font-size: 10pt;
        line-height: 1.5;
        border-bottom: 0.5pt solid #d8d8d8;
        vertical-align: top;
        color: #151617;
      }
      
      tbody tr:last-child td {
        border-bottom: none;
      }
      
      /* 코드 블록 */
      pre {
        font-family: 'SF Mono', Monaco, 'Courier New', monospace;
        font-size: 9.5pt;
        line-height: 1.5;
        background: #f6f6f6;
        border: 0.5pt solid #d8d8d8;
        border-radius: 4pt;
        padding: 9pt 12pt;
        margin: 12pt 0;
        overflow-x: visible;
        white-space: pre-wrap;
        word-wrap: break-word;
        page-break-inside: avoid;
        break-inside: avoid;
        color: #151617;
        text-align: left;
      }
      
      /* 인라인 code: 14px / 500 / bg #f6f6f6 / border 1px #d8d8d8 / radius 4px / padding 2px 5.6px */
      code {
        font-family: 'SF Mono', Monaco, 'Courier New', monospace;
        font-size: 9.5pt;
        font-weight: 500;
        background: #f6f6f6;
        padding: 1.5pt 4pt;
        border: 0.4pt solid #d8d8d8;
        border-radius: 3pt;
        color: #151617;
        text-align: left;
      }
      
      pre code {
        background: transparent;
        padding: 0;
        border: none;
        font-size: 9.5pt;
        font-weight: 400;
        color: inherit;
        text-align: left;
        display: block;
      }
      
      /* expressive-code(Shiki) */
      .expressive-code,
      .expressive-code pre,
      .expressive-code code,
      .expressive-code .frame,
      .expressive-code figure {
        text-align: left;
      }
      
      .expressive-code, .expressive-code pre {
        background: #f6f6f6 !important;
        border: 0.5pt solid #d8d8d8;
        border-radius: 4pt;
        padding: 9pt 12pt;
        margin: 12pt 0;
        page-break-inside: avoid;
        break-inside: avoid;
      }
      
      .expressive-code .frame, .expressive-code figure {
        background: transparent !important;
        margin: 0;
        padding: 0;
        border: none;
        box-shadow: none;
      }
      
      /* 리스트 - li: 16px / 400 / line-height 24px / margin 10px 0 / padding-left 16px */
      ul, ol {
        margin: 11pt 0 0 0;
        padding-left: 18pt;
      }
      
      li {
        margin: 7pt 0;
        font-size: 11pt;
        line-height: 1.5;
        color: #151617;
        page-break-inside: avoid;
        break-inside: avoid;
      }
      
      li > p {
        margin: 0;
      }
      
      /* 블록쿼트 */
      blockquote {
        margin: 12pt 0;
        padding: 8pt 12pt;
        background: #f6f6f6;
        border-left: 3pt solid #151617;
        color: #393a3e;
        page-break-inside: avoid;
        break-inside: avoid;
        font-size: 11pt;
        line-height: 1.5;
      }
      
      blockquote > :first-child { margin-top: 0; }
      blockquote > :last-child { margin-bottom: 0; }
      
      /* 이미지 - 자동 축소 */
      img {
        max-width: 100%;
        max-height: 200mm;
        height: auto;
        object-fit: contain;
        page-break-inside: avoid;
        break-inside: avoid;
        display: block;
        margin: 12pt auto;
      }
      
      figure, p:has(> img) {
        page-break-inside: avoid;
        break-inside: avoid;
        text-align: center;
      }
      
      /* [제목 + 이미지] 묶음 - 페이지 분리 방지 (ERD 등) */
      .heading-image-block {
        page-break-inside: avoid;
        break-inside: avoid;
        page-break-before: auto;
        break-before: auto;
      }
      
      /* 묶음 안의 이미지는 더 작게 - 제목/설명/마진 공간 확보 */
      .heading-image-block img {
        max-height: 170mm;
      }
      
      .heading-image-block > .sl-heading-wrapper,
      .heading-image-block > .sl-heading-wrapper > h2,
      .heading-image-block > .sl-heading-wrapper > h3,
      .heading-image-block > .sl-heading-wrapper > h4 {
        page-break-after: avoid;
        break-after: avoid;
      }
      
      figcaption {
        font-size: 9pt;
        color: #6d6d6d;
        margin-top: 4pt;
      }
      
      /* 수평선 */
      hr {
        border: none;
        border-top: 0.5pt solid #d8d8d8;
        margin: 16pt 0;
      }
      
      /* 강조 */
      strong {
        font-weight: 700;
        color: #151617;
      }
      
      em {
        font-style: italic;
      }
      
      /* Starlight Aside 박스 */
      .starlight-aside,
      aside.starlight-aside {
        margin: 12pt 0;
        padding: 10pt 14pt;
        border-left: 3pt solid #151617;
        background: #f6f6f6;
        border-radius: 0 4pt 4pt 0;
        page-break-inside: avoid;
        break-inside: avoid;
      }
      
      .starlight-aside__title {
        display: flex;
        align-items: center;
        gap: 6pt;
        font-weight: 700;
        font-size: 10.5pt;
        color: #151617;
        margin: 0 0 5pt 0;
      }
      
      .starlight-aside__content {
        font-size: 10.5pt;
        line-height: 1.5;
        color: #151617;
      }
      
      .starlight-aside__content > :first-child { margin-top: 0; }
      .starlight-aside__content > :last-child { margin-bottom: 0; }
      
      .starlight-aside--note { border-left-color: #393a3e; }
      .starlight-aside--tip { border-left-color: #151617; }
      .starlight-aside--caution { border-left-color: #6d6d6d; background: #faf5e8; }
      .starlight-aside--danger { border-left-color: #151617; background: #fbecec; }
      
      /* Card 컴포넌트 */
      .sl-link-card,
      .card {
        border: 0.5pt solid #d8d8d8;
        border-radius: 6pt;
        padding: 10pt 14pt;
        margin: 12pt 0;
        page-break-inside: avoid;
        break-inside: avoid;
        background: #fff;
      }
      
      /* Starlight 특수 요소 숨김 */
      .sl-heading-wrapper .sl-anchor-link,
      .expressive-code .header,
      .expressive-code .copy {
        display: none !important;
      }
      
      .sl-heading-wrapper {
        display: block;
      }
      
      @media print {
        @page {
          size: ${landscape ? 'A4 landscape' : 'A4'};
          margin: ${landscape ? '12mm' : '15mm 0 20mm 0'};
          
          @bottom-center {
            content: counter(page);
            font-size: 9pt;
            color: #6d6d6d;
          }
        }
        
        /* 표지 페이지 - 쪽수 없음 */
        @page cover {
          @bottom-center {
            content: none;
          }
        }
        
        /* 목차 페이지 - 쪽수 없음 */
        @page toc {
          @bottom-center {
            content: none;
          }
        }
        
        .cover-page {
          page: cover;
        }
        
        .toc-page {
          page: toc;
        }
        
        body {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
        
        .cover-page {
          margin: 0;
          padding: 0;
        }
        
        .toc-page {
          padding: 15mm;
        }
        
        .print-content {
          padding: 0;
        }
        
        .print-section-item {
          padding: 0 15mm 20mm 15mm;
        }
        
        /* 마지막 섹션 뒤 빈 페이지 방지 */
        .print-section-item:last-child {
          page-break-after: avoid;
          break-after: avoid;
        }
        
        /* 쪽수 표시 */
        .page-number {
          position: fixed;
          bottom: 10mm;
          left: 0;
          right: 0;
          text-align: center;
          font-size: 9pt;
          color: #6d6d6d;
        }
      }
      
      @media screen {
        .page-number {
          display: none;
        }
        
        .print-section-item {
          border-bottom: 1px solid #eee;
          margin-bottom: 2rem;
        }
      }
    `;

    // HTML 구성
    const combinedHtml = `<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${projectName} - ${clientName}</title>
  <style>${printStyles}</style>
</head>
<body>
  <!-- 표지 페이지 -->
  <div class="cover-page">
    <div class="cover-logo">
      <img src="${logoSrc}" alt="SKUNKWORKS" />
    </div>
    <h1 class="cover-title">${projectNameHtml}</h1>
    ${docType ? `<p class="cover-subtitle">${docType}</p>` : ''}
    <div class="cover-info">
      <div class="cover-info-item">
        <span class="cover-info-label">고객사</span>
        <strong>${clientName}</strong>
      </div>
      <div class="cover-info-item">
        <span class="cover-info-label">버전</span>
        <strong>${docVersion}</strong>
      </div>
      ${docAuthor ? `<div class="cover-info-item">
        <span class="cover-info-label">작성자</span>
        <strong>${docAuthor}</strong>
      </div>` : ''}
    </div>
    <p class="cover-date">${displayDate}</p>
  </div>

  <!-- 목차 & 변경이력 페이지 -->
  <div class="toc-page">
    <h2>목차</h2>
    <div class="toc-list">
      ${tocHtml}
    </div>
    ${revisionHtml}
  </div>

  <!-- 콘텐츠 -->
  <div class="print-content">
    ${contents.map((item, index) => `
      <div class="print-section-item">
        <div class="page-header">
          <span class="page-header-title">${projectName}</span>
          <span class="page-header-logo"><img src="${logoSrc}" alt="SKUNKWORKS" /></span>
        </div>
        <h1>${item.title}</h1>
        ${item.content}
      </div>
    `).join('')}
  </div>
</body>
</html>`;

    // 새 창 열고 인쇄
    const printWindow = window.open('', '_blank');
    if (printWindow) {
      printWindow.document.write(combinedHtml);
      printWindow.document.close();
      
      // 모든 이미지 로드 완료 대기 후 인쇄
      const waitForImages = () => {
        const images = printWindow.document.querySelectorAll('img');
        const imagePromises: Promise<void>[] = [];
        
        images.forEach(img => {
          if (!img.complete) {
            imagePromises.push(new Promise((resolve) => {
              img.onload = () => resolve();
              img.onerror = () => resolve(); // 오류 시에도 계속 진행
            }));
          }
        });
        
        return Promise.all(imagePromises);
      };
      
      // 폰트 로드 후 이미지 로드 대기
      setTimeout(async () => {
        await waitForImages();
        // 추가 대기 (렌더링 안정화)
        setTimeout(() => {
          printWindow.print();
        }, 500);
      }, 1000);
    }
  }
</script>
