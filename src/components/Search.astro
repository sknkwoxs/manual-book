---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Search.astro';
---

<div class="search-wrapper">
  <Default {...Astro.props} />
  <button 
    type="button" 
    class="ai-search-toggle" 
    id="ai-search-toggle"
    aria-label="AI 검색 열기"
    title="AI 검색"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 8V4H8"/>
      <rect width="16" height="12" x="4" y="8" rx="2"/>
      <path d="M2 14h2"/>
      <path d="M20 14h2"/>
      <path d="M15 13v2"/>
      <path d="M9 13v2"/>
    </svg>
    <span>AI</span>
  </button>
</div>

<dialog id="ai-search-dialog" class="ai-search-dialog">
  <div class="ai-search-container">
    <header class="ai-search-header">
      <h2>AI 검색</h2>
      <button type="button" class="ai-search-close" id="ai-search-close" aria-label="닫기">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
    </header>
    
    <form class="ai-search-form" id="ai-search-form">
      <input 
        type="text" 
        class="ai-search-input" 
        id="ai-search-input"
        placeholder="무엇이든 물어보세요..."
        autocomplete="off"
      />
      <button type="submit" class="ai-search-submit" id="ai-search-submit">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>
        </svg>
      </button>
    </form>

    <div class="ai-search-results" id="ai-search-results">
      <div class="ai-search-placeholder">
        AI가 매뉴얼 전체에서 답변을 찾아드립니다.
      </div>
    </div>
  </div>
</dialog>

<style>
  .search-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ai-search-toggle {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .ai-search-toggle:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  .ai-search-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 640px;
    max-height: 80vh;
    margin: 10vh auto auto;
    padding: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: var(--sl-color-bg);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .ai-search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }

  .ai-search-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    max-height: 80vh;
  }

  .ai-search-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--sl-color-gray-6);
  }

  .ai-search-header h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .ai-search-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: none;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }

  .ai-search-close:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .ai-search-form {
    display: flex;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--sl-color-gray-6);
  }

  .ai-search-input {
    flex: 1;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-white);
    font-size: 0.9375rem;
  }

  .ai-search-input:focus {
    outline: none;
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 3px var(--sl-color-accent-low);
  }

  .ai-search-input::placeholder {
    color: var(--sl-color-gray-3);
  }

  .ai-search-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: none;
    border-radius: 0.5rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .ai-search-submit:hover {
    opacity: 0.9;
  }

  .ai-search-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-search-results {
    flex: 1;
    padding: 1.25rem;
    overflow-y: auto;
  }

  .ai-search-placeholder {
    color: var(--sl-color-gray-3);
    text-align: center;
    padding: 2rem 1rem;
  }

  .ai-answer {
    line-height: 1.7;
    color: var(--sl-color-white);
  }

  .ai-answer p {
    margin: 0 0 1rem;
  }

  .ai-answer p:last-child {
    margin-bottom: 0;
  }

  .ai-sources {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .ai-sources-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .ai-source-item {
    display: block;
    padding: 0.5rem 0.75rem;
    margin-bottom: 0.5rem;
    border-radius: 0.375rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .ai-source-item:hover {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-white);
  }

  .ai-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 2rem;
    color: var(--sl-color-gray-3);
  }

  .ai-loading-spinner {
    width: 1.25rem;
    height: 1.25rem;
    border: 2px solid var(--sl-color-gray-5);
    border-top-color: var(--sl-color-accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .ai-error {
    padding: 1rem;
    border-radius: 0.5rem;
    background: rgba(239, 68, 68, 0.1);
    color: #f87171;
    text-align: center;
  }

  @media (max-width: 640px) {
    .ai-search-dialog {
      margin: 0;
      max-width: 100%;
      max-height: 100%;
      height: 100%;
      border-radius: 0;
    }

    .ai-search-container {
      max-height: 100%;
    }
  }
</style>

<script>
  const toggle = document.getElementById('ai-search-toggle');
  const dialog = document.getElementById('ai-search-dialog') as HTMLDialogElement;
  const closeBtn = document.getElementById('ai-search-close');
  const form = document.getElementById('ai-search-form');
  const input = document.getElementById('ai-search-input') as HTMLInputElement;
  const results = document.getElementById('ai-search-results');
  const submitBtn = document.getElementById('ai-search-submit') as HTMLButtonElement;

  toggle?.addEventListener('click', () => {
    dialog?.showModal();
    input?.focus();
  });

  closeBtn?.addEventListener('click', () => {
    dialog?.close();
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) {
      dialog.close();
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const query = input?.value.trim();
    if (!query || !results) return;

    submitBtn.disabled = true;
    results.textContent = '';
    const loading = document.createElement('div');
    loading.className = 'ai-loading';
    const spinner = document.createElement('div');
    spinner.className = 'ai-loading-spinner';
    const loadingText = document.createElement('span');
    loadingText.textContent = 'AI가 답변을 생성하고 있습니다...';
    loading.append(spinner, loadingText);
    results.appendChild(loading);

    try {
      const response = await fetch('/api/ai-search', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query }),
      });

      if (!response.ok) {
        throw new Error('검색에 실패했습니다.');
      }

      const data = await response.json();

      if (data.error) {
        throw new Error(data.message || data.error);
      }

      results.textContent = '';

      const answerEl = document.createElement('div');
      answerEl.className = 'ai-answer';
      answerEl.innerHTML = formatAnswer(String(data.answer ?? ''));
      results.appendChild(answerEl);

      if (Array.isArray(data.sources) && data.sources.length > 0) {
        const sourcesEl = document.createElement('div');
        sourcesEl.className = 'ai-sources';

        const sourcesTitle = document.createElement('div');
        sourcesTitle.className = 'ai-sources-title';
        sourcesTitle.textContent = '참고 문서';
        sourcesEl.appendChild(sourcesTitle);

        for (const s of data.sources as Array<{ filename?: unknown }>) {
          const filename = typeof s?.filename === 'string' ? s.filename : '';
          if (!filename) continue;
          const link = document.createElement('a');
          const url = getDocUrl(filename);
          if (url) link.href = url;
          link.className = 'ai-source-item';
          link.textContent = filename;
          sourcesEl.appendChild(link);
        }

        results.appendChild(sourcesEl);
      }

    } catch (error) {
      results.textContent = '';
      const errorEl = document.createElement('div');
      errorEl.className = 'ai-error';
      errorEl.textContent = error instanceof Error ? error.message : '알 수 없는 오류가 발생했습니다.';
      results.appendChild(errorEl);
    } finally {
      submitBtn.disabled = false;
    }
  });

  function escapeHtml(text: string): string {
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // Allow only http(s), mailto, or same-origin relative/anchor URLs.
  // Blocks dangerous schemes like javascript:, data:, vbscript:, etc.
  function sanitizeUrl(url: string): string {
    const trimmed = url.trim();
    if (!trimmed) return '';
    // Relative URLs, anchors, and same-path links are safe.
    if (/^(\/|\.\/|\.\.\/|#|\?)/.test(trimmed)) return trimmed;
    // Allow explicit http(s) and mailto schemes only.
    if (/^(https?:|mailto:)/i.test(trimmed)) return trimmed;
    // Anything else (javascript:, data:, vbscript:, file:, etc.) is rejected.
    return '';
  }

  function formatAnswer(text: string): string {
    // 마크다운 → HTML 변환 (입력은 HTML 이스케이프 후 제한된 서식만 허용)
    const lines = text.split('\n');
    let html = '';
    let inList = false;

    for (const line of lines) {
      const escaped = escapeHtml(line);
      let processed = escaped;

      // 헤딩
      if (/^### (.+)/.test(processed)) {
        if (inList) { html += '</ul>'; inList = false; }
        html += `<h4>${inlineFormat(processed.replace(/^### /, ''))}</h4>`;
        continue;
      }
      if (/^## (.+)/.test(processed)) {
        if (inList) { html += '</ul>'; inList = false; }
        html += `<h3>${inlineFormat(processed.replace(/^## /, ''))}</h3>`;
        continue;
      }
      if (/^# (.+)/.test(processed)) {
        if (inList) { html += '</ul>'; inList = false; }
        html += `<h3>${inlineFormat(processed.replace(/^# /, ''))}</h3>`;
        continue;
      }

      // 리스트
      if (/^[\-\*] (.+)/.test(processed)) {
        if (!inList) { html += '<ul>'; inList = true; }
        html += `<li>${inlineFormat(processed.replace(/^[\-\*] /, ''))}</li>`;
        continue;
      }
      if (/^\d+\.\s+(.+)/.test(processed)) {
        if (!inList) { html += '<ol>'; inList = true; }
        html += `<li>${inlineFormat(processed.replace(/^\d+\.\s+/, ''))}</li>`;
        continue;
      }

      // 리스트 종료
      if (inList && processed.trim() === '') {
        html += inList ? (html.includes('<ol>') ? '</ol>' : '</ul>') : '';
        inList = false;
        continue;
      }

      // 빈 줄
      if (processed.trim() === '') continue;

      // 일반 단락
      if (inList) { html += '</ul>'; inList = false; }
      html += `<p>${inlineFormat(processed)}</p>`;
    }

    if (inList) html += '</ul>';
    return html;
  }

  // NOTE: `text` must already be HTML-escaped by the caller.
  // We only re-insert a small set of safe tags (<strong>, <em>, <code>, <a>),
  // and link hrefs are passed through sanitizeUrl() to block javascript:/data:.
  function inlineFormat(text: string): string {
    return text
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
      .replace(/`(.+?)`/g, '<code>$1</code>')
      .replace(/\[(.+?)\]\((.+?)\)/g, (_match, label, rawHref) => {
        // rawHref is already HTML-escaped; decode the escaped quote/amp so URL parsers work,
        // then sanitize and re-escape for the attribute.
        const decoded = String(rawHref)
          .replace(/&amp;/g, '&')
          .replace(/&quot;/g, '"')
          .replace(/&#39;/g, "'")
          .replace(/&lt;/g, '<')
          .replace(/&gt;/g, '>');
        const safe = sanitizeUrl(decoded);
        if (!safe) return String(label);
        return `<a href="${escapeHtml(safe)}" rel="noopener noreferrer">${label}</a>`;
      });
  }

  function getDocUrl(filename: string): string {
    const path = filename
      .replace(/^docs\//, '')
      .replace(/\.mdx?$/, '')
      .replace(/\/index$/, '/');
    // Only return a same-origin relative path. Reject anything that could become
    // an absolute URL or a javascript:/data: scheme after the leading slash.
    if (/^[\w\-./%]*$/.test(path)) {
      return '/' + path;
    }
    return '';
  }
</script>
