---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Search.astro';
---

<div class="search-wrapper">
  <Default {...Astro.props} />
  <button 
    type="button" 
    class="ai-search-toggle" 
    id="ai-search-toggle"
    aria-label="AI 검색 열기"
    title="AI 검색"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 8V4H8"/>
      <rect width="16" height="12" x="4" y="8" rx="2"/>
      <path d="M2 14h2"/>
      <path d="M20 14h2"/>
      <path d="M15 13v2"/>
      <path d="M9 13v2"/>
    </svg>
    <span>AI</span>
  </button>
</div>

<dialog id="ai-search-dialog" class="ai-search-dialog">
  <div class="ai-search-container">
    <header class="ai-search-header">
      <h2>AI 검색</h2>
      <button type="button" class="ai-search-close" id="ai-search-close" aria-label="닫기">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
    </header>
    
    <form class="ai-search-form" id="ai-search-form">
      <input 
        type="text" 
        class="ai-search-input" 
        id="ai-search-input"
        placeholder="무엇이든 물어보세요..."
        autocomplete="off"
      />
      <button type="submit" class="ai-search-submit" id="ai-search-submit">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>
        </svg>
      </button>
    </form>

    <div class="ai-search-results" id="ai-search-results">
      <div class="ai-search-placeholder">
        AI가 매뉴얼 전체에서 답변을 찾아드립니다.
      </div>
    </div>
  </div>
</dialog>

<style>
  .search-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ai-search-toggle {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .ai-search-toggle:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  .ai-search-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 640px;
    max-height: 80vh;
    margin: 10vh auto auto;
    padding: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: var(--sl-color-bg);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .ai-search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }

  .ai-search-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    max-height: 80vh;
  }

  .ai-search-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--sl-color-gray-6);
  }

  .ai-search-header h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .ai-search-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: none;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }

  .ai-search-close:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .ai-search-form {
    display: flex;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--sl-color-gray-6);
  }

  .ai-search-input {
    flex: 1;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-white);
    font-size: 0.9375rem;
  }

  .ai-search-input:focus {
    outline: none;
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 3px var(--sl-color-accent-low);
  }

  .ai-search-input::placeholder {
    color: var(--sl-color-gray-3);
  }

  .ai-search-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: none;
    border-radius: 0.5rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .ai-search-submit:hover {
    opacity: 0.9;
  }

  .ai-search-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-search-results {
    flex: 1;
    padding: 1.25rem;
    overflow-y: auto;
  }

  .ai-search-placeholder {
    color: var(--sl-color-gray-3);
    text-align: center;
    padding: 2rem 1rem;
  }

  .ai-answer {
    line-height: 1.7;
    color: var(--sl-color-white);
  }

  .ai-answer p {
    margin: 0 0 1rem;
  }

  .ai-answer p:last-child {
    margin-bottom: 0;
  }

  .ai-sources {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .ai-sources-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .ai-source-item {
    display: block;
    padding: 0.5rem 0.75rem;
    margin-bottom: 0.5rem;
    border-radius: 0.375rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .ai-source-item:hover {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-white);
  }

  .ai-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 2rem;
    color: var(--sl-color-gray-3);
  }

  .ai-loading-spinner {
    width: 1.25rem;
    height: 1.25rem;
    border: 2px solid var(--sl-color-gray-5);
    border-top-color: var(--sl-color-accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .ai-error {
    padding: 1rem;
    border-radius: 0.5rem;
    background: rgba(239, 68, 68, 0.1);
    color: #f87171;
    text-align: center;
  }

  @media (max-width: 640px) {
    .ai-search-dialog {
      margin: 0;
      max-width: 100%;
      max-height: 100%;
      height: 100%;
      border-radius: 0;
    }

    .ai-search-container {
      max-height: 100%;
    }
  }
</style>

<script>
  const toggle = document.getElementById('ai-search-toggle');
  const dialog = document.getElementById('ai-search-dialog') as HTMLDialogElement;
  const closeBtn = document.getElementById('ai-search-close');
  const form = document.getElementById('ai-search-form');
  const input = document.getElementById('ai-search-input') as HTMLInputElement;
  const results = document.getElementById('ai-search-results');
  const submitBtn = document.getElementById('ai-search-submit') as HTMLButtonElement;

  toggle?.addEventListener('click', () => {
    dialog?.showModal();
    input?.focus();
  });

  closeBtn?.addEventListener('click', () => {
    dialog?.close();
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) {
      dialog.close();
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const query = input?.value.trim();
    if (!query || !results) return;

    submitBtn.disabled = true;
    results.innerHTML = `
      <div class="ai-loading">
        <div class="ai-loading-spinner"></div>
        <span>AI가 답변을 생성하고 있습니다...</span>
      </div>
    `;

    try {
      const response = await fetch('/api/ai-search', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query }),
      });

      if (!response.ok) {
        throw new Error('검색에 실패했습니다.');
      }

      const data = await response.json();

      if (data.error) {
        throw new Error(data.message || data.error);
      }

      let html = `<div class="ai-answer">${formatAnswer(data.answer)}</div>`;

      if (data.sources && data.sources.length > 0) {
        html += `
          <div class="ai-sources">
            <div class="ai-sources-title">참고 문서</div>
            ${data.sources.map((s: any) => `
              <a href="${getDocUrl(s.filename)}" class="ai-source-item">
                ${s.filename}
              </a>
            `).join('')}
          </div>
        `;
      }

      results.innerHTML = html;

    } catch (error) {
      results.innerHTML = `
        <div class="ai-error">
          ${error instanceof Error ? error.message : '알 수 없는 오류가 발생했습니다.'}
        </div>
      `;
    } finally {
      submitBtn.disabled = false;
    }
  });

  function formatAnswer(text: string): string {
    return text
      .split('\n\n')
      .map(p => `<p>${p}</p>`)
      .join('');
  }

  function getDocUrl(filename: string): string {
    return '/' + filename
      .replace(/^docs\//, '')
      .replace(/\.mdx?$/, '')
      .replace(/\/index$/, '/');
  }
</script>
