---
/**
 * 커스텀 Sidebar 컴포넌트
 * 현재 URL에 따라 해당 프로젝트의 사이드바만 표시
 */
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

// 현재 페이지 경로에서 프로젝트 prefix 추출
const currentPath = Astro.url.pathname;
const pathParts = currentPath.split('/').filter(Boolean);
const projectPrefix = pathParts[0] || '';

// 홈페이지인 경우 사이드바 비움
const isHomePage = currentPath === '/' || currentPath === '';

// Starlight의 원본 sidebar 가져오기
const originalSidebar = Astro.locals.starlightRoute?.sidebar || [];

// sidebar 항목에서 프로젝트 경로 추출하는 함수
const getProjectFromItem = (item: any): string | null => {
  if (item.href) {
    return item.href.split('/').filter(Boolean)[0] || null;
  }
  if (item.entries && item.entries.length > 0) {
    for (const entry of item.entries) {
      const project = getProjectFromItem(entry);
      if (project) return project;
    }
  }
  return null;
};

// sidebar 항목 필터링
let filteredSidebar = originalSidebar;

if (isHomePage) {
  filteredSidebar = [];
} else if (projectPrefix) {
  filteredSidebar = originalSidebar.filter((group: any) => {
    const groupProject = getProjectFromItem(group);
    return groupProject === projectPrefix;
  });
}
---

<SidebarPersister>
  <SidebarSublist sublist={filteredSidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
